/* Um servico/ponto de apoio = um NO da lista encadeada */
typedef struct Servico {
    int  id;
    char titulo[160], categoria[24], regiao[16], bairro[64];
    char descricao[320], requisitos[128];
    int  capacidade;                   /* vagas informadas (0 = nao informado) */
    char fonte[320], data_consulta[16], status[100];
    struct Servico *prox;
} Servico;
 
typedef struct {
    Servico *inicio, *fim;
    int total;
    int alterada;                      /* 1 se houve cadastro/edicao/exclusao */
} Lista;
 
